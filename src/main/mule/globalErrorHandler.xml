	<configuration doc:name="Configuration" doc:id="8d6616ee-b84d-4cb8-9da3-ed7d2444d0a1" defaultErrorHandler-ref="globalErrorHandlerError_Handler" />
	<configuration-properties doc:name="Configuration properties" doc:id="feed689a-2ed7-4f95-a824-9bc75500015c" file="dev.properties" />
	<api-gateway:autodiscovery apiId="20513860" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="68acbdd0-aedd-472f-86b7-bad3b46a9831" flowRef="dummy-apiFlow" />
	<error-handler name="globalErrorHandlerError_Handler" doc:id="da6a71f7-4753-409a-9726-277f40d48bd8" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="349d679d-de28-4012-96c0-5f2a467812ef" >
